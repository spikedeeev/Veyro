DATABASE_URL="postgresql://clothingstore:replace-with-root-env-password@localhost:5432/clothingstore?schema=public"

JWT_ACCESS_SECRET=replace-with-a-unique-random-secret
JWT_REFRESH_SECRET=replace-with-another-unique-random-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

REDIS_HOST=localhost
REDIS_PORT=6379
# Set REDIS_URL for managed Redis providers such as Upstash (rediss://...).
REDIS_URL=
PORT=3000
NODE_ENV=development

# Public URL of this API, used to build links to stored images
PUBLIC_BASE_URL=http://localhost:3000
UPLOADS_DIR=uploads
# Optional cloud image storage. When all three values are set, uploads go to Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Extra hosts allowed for image import, comma-separated (images.unsplash.com and images.pexels.com are always allowed)
IMAGE_IMPORT_HOSTS=

# Frontend base URL used in password reset links
FRONTEND_URL=http://localhost:5173

# Mail. Local dev: Mailpit from docker compose (UI: http://localhost:8025). Leave SMTP_HOST empty to only log emails
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Veyro <no-reply@veyro.local>

# Stripe (https://dashboard.stripe.com/test/apikeys). Leave STRIPE_SECRET_KEY empty to disable online payments.
# Use a test key (sk_test_...) locally. STRIPE_WEBHOOK_SECRET (whsec_...) comes from `stripe listen` or the dashboard endpoint.
# STRIPE_CURRENCY must be a currency enabled for your Stripe account (e.g. usd, eur).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# Unpaid orders are cancelled and their stock is released after this many minutes (0 disables)
ORDER_PAYMENT_TIMEOUT_MINUTES=60

# Requests per minute per IP (stricter limits apply to auth, orders, reviews)
RATE_LIMIT_PER_MINUTE=120
# Set to true when running behind a reverse proxy
TRUST_PROXY=false
# Swagger UI at /api/docs; set to false to disable
SWAGGER_ENABLED=true
